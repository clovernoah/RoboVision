# 模型权重（体积较大，可随时重新下载）
models/*.pt
models/*.onnx
models/*.pth
models/*.part

# 训练与评估产物：只保留演示所需的 best.pt，其余日志/曲线不提交
runs/*
!runs/.gitkeep

!runs/robotnav/
runs/robotnav/*
!runs/robotnav/best.pt

!runs/cartpole/
runs/cartpole/*
!runs/cartpole/best.pt

!runs/robotnav_vanilla/
runs/robotnav_vanilla/*
!runs/robotnav_vanilla/best.pt

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/
*.log
# 训练过程材料中的原始日志需要随文档提交
!docs/training/*.log

